{
  "name": "@l33tdawg/dsh-recall-gate",
  "version": "0.1.0",
  "description": "Refuse the first file-mutating tool call of a turn until the turn's memory recall has run.",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "guard"
  ],
  "type": "module",
  "license": "MIT",
  "main": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node --test --experimental-strip-types --test-force-exit \"tests/*.test.ts\" \"tests/*.e2e.ts\""
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  }
}
