{
  "name": "@l33tdawg/dsh-verify-on-edit",
  "version": "0.2.0",
  "description": "Track edits, run project checks through the session shell policy, and report verification before completion.",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "verification",
    "typecheck",
    "reliability"
  ],
  "type": "module",
  "license": "MIT",
  "main": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node --test --experimental-strip-types --test-force-exit \"tests/*.test.ts\" \"tests/*.e2e.ts\""
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-tools": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
