{
  "name": "@l33tdawg/dsh-guidance-pack",
  "version": "0.1.0",
  "description": "Behavioural prompt guidance for DeepSeek Harness: planning, verification, editing, and reporting discipline the base harness prompt does not ship.",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "system-prompt",
    "guidance"
  ],
  "type": "module",
  "license": "MIT",
  "main": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node --test --experimental-strip-types --test-force-exit \"tests/*.test.ts\""
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
